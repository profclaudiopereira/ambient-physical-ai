# Ambient Physical AI — Ambient Context Service
#
# Copy this file to:
#
#   /root/ambient-runtime/runtime/cognitive/stackflow/.env.ambient-context
#
# Then edit the values and load it before running:
#
#   set -a
#   . ./.env.ambient-context
#   set +a

# REQUIRED: fixed/reserved Tab5 address
TAB5_HOST=192.168.77.203
TAB5_PORT=5555

# Default profile used for an isolated test.
AMBIENT_PROFILE=claudio

# Recife / PE
AMBIENT_LATITUDE=-8.0476
AMBIENT_LONGITUDE=-34.8770
AMBIENT_LOCATION=RECIFE

AMBIENT_TTL_SECONDS=900
AMBIENT_INTERVAL_SECONDS=900

# Optional. V1 development/test key defaults to 123 when omitted.
# THESPORTSDB_API_KEY=123

# Optional. Resolving the team dynamically avoids hard-coding an uncertain ID.
SPORT_TEAM_NAME="Sport Club do Recife"
# SPORT_TEAM_ID=

# Required only for Mariana / TMDB.
# Paste the TMDB API Read Access Token (Bearer token), not the API key.
